{
  "name": "@first-commit/components",
  "version": "0.0.1",
  "type": "module",
  "keywords": [
    "svelte"
  ],
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input ./src --tsconfig ./tsconfig.build.json",
    "clean": "shx rm -rf {node_modules,.turbo,dist,coverage,.svelte-kit}",
    "dev": "svelte-package --input ./src --watch",
    "test": "bun test --coverage",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.59.2"
  },
  "dependencies": {
    "bits-ui": "^2.22.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js"
}
