{
  "name": "storybook",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "storybook build",
    "clean": "shx rm -rf {node_modules,.turbo,storybook-static,coverage}",
    "dev": "storybook dev -p 6006",
    "test": "vitest --coverage",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@first-commit/design-tokens": "workspace:*",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-svelte-csf": "latest",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/svelte-vite": "^10.6.9",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "playwright": "latest",
    "storybook": "^10.6.9",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "latest"
  }
}
